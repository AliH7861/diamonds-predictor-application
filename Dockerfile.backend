FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TF_CPP_MIN_LOG_LEVEL=2 \
    DIAMOND_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

WORKDIR /app

COPY requirements-assistant.txt ./
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements-assistant.txt

COPY config.py ./
COPY src ./src
COPY knowledge ./knowledge

EXPOSE 8770

HEALTHCHECK --interval=20s --timeout=5s --start-period=90s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8770/health', timeout=4)"

CMD ["python", "-m", "src.assistant.api", "--host", "0.0.0.0", "--port", "8770"]
